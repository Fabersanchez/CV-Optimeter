# CV Optimeter AI - Environment Variables Reference

# Project Settings
PROJECT_NAME="CV Optimeter AI"
VERSION="1.0.0"
ENV="development"

# FastAPI Backend Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
SECRET_KEY="cv-optimeter-super-secret-key-change-in-prod-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Credentials (Optional: Engine automatically falls back to offline NLP)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Database Configuration (PostgreSQL)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="cv_optimeter_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/cv_optimeter_db"

# Redis Cache & Task Queue Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
